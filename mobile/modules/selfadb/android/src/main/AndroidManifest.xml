<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- adb client connects over TCP (localhost adbd) -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- foreground service so clipboard sync survives the app being swiped away -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Proximity auto-lock: advertise a BLE presence beacon so the Mac can lock when this phone
    leaves the room. BLUETOOTH_ADVERTISE is the "Nearby devices" runtime permission (Android
    12+); advertising never derives location so no location permission is needed. Legacy
    BLUETOOTH(_ADMIN) cover API <= 30. The beacon runs in the foreground service, so it needs
    the connectedDevice FGS type on Android 14+.
  -->
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

  <!--
    Messages mirroring (Android → Mac): read the SMS store and resolve sender contact names so the
    Mac dashboard can show real conversation threads. Both are dangerous runtime permissions, granted
    via the in-app "Grant SMS access" action (Settings). READ_SMS is Play-restricted, but this app is
    sideloaded (EAS preview APK), so the policy doesn't apply. Reading runs in the foreground service
    (SmsMirror), so it survives an app swipe like the notification listener.
  -->
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />

  <!--
    Reply to messages (Mac → Android → SMS stack): send a real SMS via SmsManager on the Mac
    dashboard's request. Dangerous runtime permission, requested lazily on the first reply attempt
    (not bundled with READ_SMS/READ_CONTACTS above) via the in-app "Grant SMS Send Access" action.
  -->
  <uses-permission android:name="android.permission.SEND_SMS" />

  <!-- mDNS discovery of _adb-tls-pairing / _adb-tls-connect via NsdManager -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <!-- Gate LAN/mDNS discovery on Wi-Fi presence (ConnectivityManager.registerNetworkCallback):
       no Wi-Fi -> the Mac can't be on the LAN, so we drop discovery + its multicast lock and
       rely on the relay. Saves battery when out and about. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- keep the relay WS alive under doze / aggressive OEM battery management -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!--
    Self-toggle of wireless debugging (Settings.Global "adb_wifi_enabled") so a
    paired device can silently reconnect after reboot with NO 6-digit code. A
    normal app can't hold this, but its protection level carries the
    `development` flag, so we grant it to ourselves over our own adb session on
    first pair:  pm grant <pkg> android.permission.WRITE_SECURE_SETTINGS
    It MUST be declared here for that grant to be accepted.
  -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
    tools:ignore="ProtectedPermissions" />

  <!--
    Per-app notification-mirroring filter: enumerate launcher apps for the "Select apps" picker
    (Settings ▸ Notifications). Android 11+ package visibility hides other apps unless declared;
    this intent query merges into the app manifest and exposes exactly the launcher set.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    LAN-direct mode talks plain ws:// to the Mac on the local network (no TLS on the LAN), and
    the relay can also be configured as ws://. Content is still E2E-encrypted (ChaCha20-Poly1305),
    so the cleartext transport carries only opaque ciphertext. API 28+ blocks cleartext by default;
    this re-permits it. Merges into the app's <application>.
  -->
  <application android:usesCleartextTraffic="true">
    <service
      android:name=".ClipForegroundService"
      android:exported="false"
      android:foregroundServiceType="specialUse|connectedDevice">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="clipboard_sync" />
    </service>

    <!--
      File transfer (Mac → phone clipboard image): received images are written to
      cacheDir/clips and put on the system clipboard as a content URI from this provider
      (the clipboard service propagates the read grant to whichever app pastes). Authority
      is templated on ${applicationId} so dev + prod installs never collide.
    -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.selfadb.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/selfadb_file_paths" />
    </provider>

    <!--
      Manual clipboard capture — the ADB-free half of the pipeline. The shell daemon is the only
      thing that can see a copy on its own (background clipboard READS are focus-gated by
      AOSP's ClipboardService), and it needs ADB, which needs Wireless Debugging, which needs
      Wi-Fi. These two activities need none of that, so capture degrades to one tap instead of
      stopping when the daemon is gone.

      Neither declares android:label on purpose: without one they inherit the application label,
      which is per-variant ("LinkToMac (Dev)" vs "Link to Mac"), so a dev and a release install
      are told apart in the text-selection toolbar without this module knowing which variant it
      was built into.
    -->

    <!--
      Text-selection toolbar entry. The selection arrives in EXTRA_PROCESS_TEXT, so the
      clipboard is never touched and no window focus is needed -> NoDisplay is right here.
    -->
    <activity
      android:name=".ProcessTextActivity"
      android:theme="@android:style/Theme.NoDisplay"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!--
      Reads the clipboard for the notification's "Send clipboard" action. Needs a REAL window:
      clipboardAccessAllowed() checks mWm.isUidFocused(uid), and a NoDisplay activity is never
      given one, so getPrimaryClip() would return null every time. The Invisible theme is a real
      window that paints nothing and animates nothing. Not exported — only our own notification
      launches it.

      `taskAffinity=""` is load-bearing: with the default affinity this activity belongs to the
      APP's task, so FLAG_ACTIVITY_NEW_TASK brings that whole task forward and starts on top of
      it — the user taps "Send clipboard" and the app visibly opens behind the transparent
      window, then stays open. An empty affinity gives it a task of its own, so the app is never
      touched and the system returns to whatever was in front once it finishes.
    -->
    <activity
      android:name=".ClipboardReadActivity"
      android:theme="@style/Theme.LinkToMac.Invisible"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:exported="false" />

    <!--
      Notification mirroring: a NotificationListenerService that captures every posted/removed
      notification and forwards it to the Mac. `BIND_NOTIFICATION_LISTENER_SERVICE` + the
      service intent-filter are how the system recognises it; the user must still grant
      "Notification access" in system settings (a special access, not a runtime permission).
    -->
    <service
      android:name=".NotificationListener"
      android:exported="false"
      android:label="Link to macOS notifications"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>

</manifest>
