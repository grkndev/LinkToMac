# Relay endpoint the phone connects to. Copy to .env (gitignored) and fill in.
#
#   RELAY_HOST   public IP or domain of your relay. Leave empty in dev to auto-use the
#                Metro dev-server host (the Mac running `expo start`).
#   RELAY_TOKEN  must match server/.env RELAY_AUTH_TOKEN. Generate: openssl rand -hex 32
RELAY_HOST=
RELAY_TOKEN=
