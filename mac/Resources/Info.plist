<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>LinkToMac</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Regular app: Dock icon + a main dashboard window, plus the menu-bar extra. Closing the
	     window leaves the app alive in the menu bar (see AppDelegate). -->
	<key>LSUIElement</key>
	<false/>
	<!-- Bluetooth: scan for the phone's presence beacon to auto-lock when it leaves. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>LinkToMac scans for your paired phone over Bluetooth to lock this Mac when you walk away.</string>
	<!-- Allow cleartext ws:// to a LAN/dev relay. The relay endpoint itself (host/port/TLS/
	     password) is configured at runtime in the "Server Settings…" window — not baked in. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- LAN-direct mode: this Mac runs a WebSocket server and advertises it over Bonjour so a
	     phone on the same network connects without a relay. macOS 14+ gates local networking on
	     a usage string + the declared service type. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>LinkToMac connects directly to your paired phone on the local network to sync the clipboard without a relay server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_linktomac._tcp</string>
	</array>
	<!-- Sparkle auto-update. The feed is the appcast attached to the GitHub "latest" release;
	     SUFeedURL stays stable across versions. SUPublicEDKey is the EdDSA public key whose
	     private half lives in the developer's login Keychain (used by sign_update at release). -->
	<key>SUFeedURL</key>
	<string>https://github.com/grkndev/LinkToMac/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>OWFkrCYelihBqu7sisiCeOf12CrQ2kOq/OaQZXoumYs=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
