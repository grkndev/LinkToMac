// Build settings for the LinkToMac menubar app.
//
// The relay endpoint (host / port / TLS / password) is NO LONGER set here — it is configured
// at runtime in the app's "Server Settings…" window and persisted to UserDefaults + Keychain
// (see ServerSettings.swift). Nothing relay-related is baked into the build anymore.
//
// Kept as the target's base config file (referenced by project.yml). The optional include below
// is now a no-op unless you re-introduce build-time settings.
#include? "Secrets.xcconfig"
