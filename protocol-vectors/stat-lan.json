   },
   {
    "name": "an_invalid_port_yields_nothing",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     }
    ],
    "port": 80,
    "expect": []
   },
   {
    "name": "a_missing_ipv4_is_skipped",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": null
     },
     {
      "name": "en1",
      "up": true,
