{
 "description": "The Mac's LAN address hint (stat.lan, plan note 'LAN rediscovery'). The Mac writes the private IPv4 addresses of its Ethernet/Wi-Fi interfaces into its own `stat` as `\"lan\":[\"a.b.c.d:port\", ...]`, so the phone can reach the Mac's LAN-direct server over a relay-learned address when mDNS multicast does not get through. Swift (`mac/Tests/StatLanVectorTests.swift`) and Kotlin (`StatLanVectorTest.kt`) run the same `parse` cases; only the Mac builds the field, so `pick` is run by Swift alone. The hint is untrusted input (the LAN handshake authenticates the peer): anything malformed is dropped quietly and never fatal.",
 "parse": {
  "description": "What the phone makes of a decoded stat object (`stat`). `expect.update`: `absent` (no usable `lan`: the receiver keeps what it knows; `lan` must be a JSON array) or `hints` with the accepted `\"a.b.c.d:port\"` strings in order. Rules: each item a string of at most 21 characters in canonical form (four decimal octets 0-255 without leading zeros, one colon, a decimal port 1024-65535 without sign or leading zero); the address must be RFC 1918 (10/8, 172.16/12, 192.168/16); duplicates collapse; at most 3 are kept (the first valid ones); anything else is skipped.",
  "cases": [
   {
    "name": "no_lan_field",
    "kind": "parse",
    "stat": {
     "level": 80,
     "charging": false
    },
    "expect": {
     "update": "absent"
    }
   },
   {
    "name": "lan_is_a_string",
    "kind": "parse",
    "stat": {
     "lan": "192.168.1.10:53124"
    },
    "expect": {
     "update": "absent"
    }
   },
   {
    "name": "lan_is_a_number",
    "kind": "parse",
    "stat": {
     "lan": 5
    },
    "expect": {
     "update": "absent"
    }
   },
   {
    "name": "lan_is_an_object",
    "kind": "parse",
    "stat": {
     "lan": {
      "h": "192.168.1.10"
     }
    },
    "expect": {
     "update": "absent"
    }
   },
   {
    "name": "lan_is_null",
    "kind": "parse",
    "stat": {
     "lan": null
    },
    "expect": {
     "update": "absent"
    }
   },
   {
    "name": "empty_array_means_no_hints",
    "kind": "parse",
    "stat": {
     "lan": []
    },
    "expect": {
     "update": "hints",
     "hints": []
    }
   },
   {
    "name": "one_valid_192_168",
    "kind": "parse",
    "stat": {
     "lan": [
      "192.168.1.10:53124"
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "192.168.1.10:53124"
     ]
    }
   },
   {
    "name": "other_stat_fields_do_not_matter",
    "kind": "parse",
    "stat": {
     "level": 80,
     "charging": true,
     "name": "Pixel",
     "caps": [
      "q1"
     ],
     "lan": [
      "10.0.0.7:53124"
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "10.0.0.7:53124"
     ]
    }
   },
   {
    "name": "three_valid_in_order",
    "kind": "parse",
    "stat": {
     "lan": [
      "192.168.1.10:53124",
      "10.0.0.7:53124",
      "172.16.5.4:53124"
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "192.168.1.10:53124",
      "10.0.0.7:53124",
      "172.16.5.4:53124"
     ]
    }
   },
   {
    "name": "a_fourth_valid_one_is_dropped",
    "kind": "parse",
    "stat": {
     "lan": [
      "192.168.1.10:53124",
      "10.0.0.7:53124",
      "172.16.5.4:53124",
      "192.168.2.2:53124"
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "192.168.1.10:53124",
      "10.0.0.7:53124",
      "172.16.5.4:53124"
     ]
    }
   },
   {
    "name": "duplicates_collapse",
    "kind": "parse",
    "stat": {
     "lan": [
      "192.168.1.10:53124",
      "192.168.1.10:53124",
      "10.0.0.7:53124"
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "192.168.1.10:53124",
      "10.0.0.7:53124"
     ]
    }
   },
   {
    "name": "invalid_items_are_skipped_not_fatal",
    "kind": "parse",
    "stat": {
     "lan": [
      "nonsense",
      "192.168.1.10:53124",
      7,
      null,
      {
       "x": 1
      },
      [
       "a"
      ]
     ]
    },
    "expect": {
     "update": "hints",
     "hints": [
      "192.168.1.10:53124"
     ]
    }
   },
   {
    "name": "a_public_address_is_refused",
    "kind": "parse",
    "stat": {
     "lan": [
      "8.8.8.8:53124"
     ]
    },
