 },
 "pick": {
  "description": "Which addresses the Mac puts in `stat.lan` from a list of its interfaces (`interfaces`: name, up, running, loopback, ipv4 or null) and its LAN server `port`. Rules: only interfaces named `en<number>` that are up AND running and not loopback, with a private IPv4 (the same rule as `parse`); ordered by interface number (`en0` first, numerically: `en2` before `en10`); duplicates collapse; at most 3; a port outside 1024-65535 yields none.",
  "cases": [
   {
    "name": "one_wifi_interface",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     }
    ],
    "port": 53124,
    "expect": [
     "192.168.1.10:53124"
    ]
   },
   {
    "name": "en0_first_then_by_name",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en5",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "10.0.0.5"
     },
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     },
     {
      "name": "en1",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "172.16.0.9"
     }
    ],
    "port": 53124,
    "expect": [
     "192.168.1.10:53124",
     "172.16.0.9:53124",
     "10.0.0.5:53124"
    ]
   },
   {
    "name": "a_down_interface_is_skipped",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": false,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     },
     {
      "name": "en1",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "10.0.0.5"
     }
    ],
    "port": 53124,
    "expect": [
     "10.0.0.5:53124"
    ]
   },
   {
    "name": "a_not_running_interface_is_skipped",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": true,
      "running": false,
      "loopback": false,
      "ipv4": "192.168.1.10"
     }
    ],
    "port": 53124,
    "expect": []
   },
   {
    "name": "loopback_is_skipped",
    "kind": "pick",
    "interfaces": [
     {
      "name": "lo0",
      "up": true,
      "running": true,
      "loopback": true,
      "ipv4": "127.0.0.1"
     },
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     }
    ],
    "port": 53124,
    "expect": [
     "192.168.1.10:53124"
    ]
   },
   {
    "name": "only_en_interfaces",
    "kind": "pick",
    "interfaces": [
     {
      "name": "awdl0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "169.254.1.1"
     },
     {
      "name": "utun3",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "10.9.9.9"
     },
     {
      "name": "bridge100",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.64.1"
     },
     {
      "name": "llw0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "169.254.2.2"
     },
     {
      "name": "ap1",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.5.1"
     },
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "192.168.1.10"
     }
    ],
    "port": 53124,
    "expect": [
     "192.168.1.10:53124"
    ]
   },
   {
    "name": "a_public_address_on_en0_is_skipped",
    "kind": "pick",
    "interfaces": [
     {
      "name": "en0",
      "up": true,
      "running": true,
      "loopback": false,
      "ipv4": "8.8.8.8"
     },
     {
      "name": "en1",
