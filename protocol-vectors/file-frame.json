      },
      "expect": {
        "max_header_bytes": 65535,
        "dir_dropped": true,
        "name_shorter": true,
        "id": "i",
        "seq": 0,
        "count": 1,
        "bytes_hex": "0707"
      },
      "note": "dir is shed first, then name is shortened; header length is a u16, never a wrapped length"
