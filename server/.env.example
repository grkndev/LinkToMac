# Relay configuration. Copy to .env and adjust:  cp .env.example .env

# --- Network ---
HOST=0.0.0.0
PORT=8080

# --- Access control ---
# Defense-in-depth on top of the 256-bit roomId bearer. REQUIRED in production.
# Generate one with:  openssl rand -hex 32
RELAY_AUTH_TOKEN=
# Set to true ONLY for local dev to allow connections without a token.
ALLOW_NO_AUTH=false

# --- Room / payload limits ---
MAX_PEERS_PER_ROOM=2
MAX_PAYLOAD_BYTES=262144

# --- Liveness & timeouts (ms) ---
PING_INTERVAL_MS=30000
JOIN_TIMEOUT_MS=10000

# --- Per-connection rate limit ---
RATE_LIMIT_MSGS=120
RATE_LIMIT_WINDOW_MS=10000

# --- Logging ---
LOG_LEVEL=info
